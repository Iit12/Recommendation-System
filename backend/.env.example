# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Persistence Configuration (Phase 5)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=smart_shopping

# Live Data Acquisition Configuration (Phase 8.5.1 / 8.5.2)
DATA_SOURCE_MODE=mock

# QuickCommerce API Configuration (Phase 8.5.2)
# Real-time multi-platform quick commerce & marketplace data
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_API_BASE_URL=https://api.quickcommerceapi.com
QUICKCOMMERCE_TIMEOUT_MS=10000

# Amazon Creators API Configuration (OAuth 2.0 Bearer)
# Obtain from Amazon Associates / Creators API Console
AMAZON_CREATOR_CLIENT_ID=
AMAZON_CREATOR_CLIENT_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.in
AMAZON_API_BASE_URL=https://creatorsapi.amazon
AMAZON_AUTH_URL=https://api.amazon.com/auth/o2/token
AMAZON_TIMEOUT_MS=8000
